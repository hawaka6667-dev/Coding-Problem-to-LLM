{
  "manifest_version": 3,
  "name": "Coding-Problem-to-LLM",
  "version": "0.3.0",
  "description": "Send coding problems from Exercism, LeetCode, etc. directly to any LLM for review and discussion.",
  "permissions": [
    "tabs",
    "debugger"
  ],
  "host_permissions": [
    "https://exercism.org/*",
    "https://leetcode.com/*",
    "https://chat.deepseek.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Coding-Problem-to-LLM - Send to LLM"
  },
  "commands": {
    "run-workflow": {
      "suggested_key": {
        "default": "Ctrl+Shift+E"
      },
      "description": "Send coding problem to LLM"
    }
  }
}
